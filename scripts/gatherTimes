#!/usr/bin/env python
"""Rebuild an archive's document from the HDF5 file it belongs to.

For when a run's ``.ymf``/``.xmf`` is missing, truncated, or was never
written because the job died before the archive closed. The heavy data is
already in the ``.h5``, and so is the per-step grid metadata, so the
document can be regenerated without re-running anything.

The ``.h5`` is self-describing: it records the metadata format version, the
time-collection names, and whether the run wrote global arrays or one grid
per subdomain. So this needs no ``.xmf`` to seed from and no flags telling
it which layout to expect -- the previous version required both, opening
``<name>.xmf`` for its Domain skeleton and taking ``--no-global-sync`` on
trust.

Writes ``<name><addname>.ymf`` (the archive of record) and a matching
``.xmf`` for viewers. ``ymf2xdmf`` does the second step alone if that is
all that is wanted.
"""
import os


def gatherTimes(filename, dataDir='.', addname="_complete", tCount=None,
                global_sync=True):
    """Regenerate the document for ``<dataDir>/<filename>.h5``.

    ``tCount`` and ``global_sync`` are accepted for command-line
    compatibility. Both are now read from the archive itself: the step
    count by discovering the metadata that is present, and the layout from
    the attribute the writer records.
    """
    from proteus.Archiver import readArchiveDomain
    from ymf.archive import write_ymf
    from ymf.xdmf import write_xdmf

    domain = readArchiveDomain(filename, dataDir=dataDir)
    if not domain:
        raise SystemExit(
            "gatherTimes: %s holds no grid metadata to rebuild from"
            % (os.path.join(dataDir, filename + ".h5"),))

    for collection in domain.get("TimeCollections", []):
        steps = collection["Data"]
        if tCount is not None and tCount >= 0 and len(steps) > tCount:
            print("%s: keeping %d of %d step(s)"
                  % (collection["Name"], tCount, len(steps)))
            collection["Data"] = steps[:tCount]
        else:
            print("%s: %d step(s)" % (collection["Name"], len(steps)))

    out_base = os.path.join(dataDir, filename + addname)
    write_ymf(domain, out_base + ".ymf")
    print("wrote %s.ymf" % (out_base,))
    write_xdmf(domain, out_base + ".xmf")
    print("wrote %s.xmf" % (out_base,))


if __name__ == '__main__':
    from optparse import OptionParser
    usage = "usage: %prog [options] filename"
    parser = OptionParser(usage=usage)
    parser.add_option("-t","--tCount",
                      help="keep only this many time steps (default: all)",
                      action="store",
                      type="int",
                      dest="tCount",
                      default="-1")
    parser.add_option("-n","--no-global-sync",
                      help="accepted for compatibility; the archive records "
                           "its own layout",
                      action="store_true",
                      dest="not_global_sync",
                      default=False)

    (opts,args) = parser.parse_args()
    if not args:
        parser.error("give the archive's base name (or its .xmf/.ymf/.h5)")
    filebase = args[0]
    for suffix in (".xmf", ".ymf", ".h5"):
        if filebase.endswith(suffix):
            filebase = filebase[:-len(suffix)]
            break
    gatherTimes(filebase, tCount=opts.tCount,
                global_sync=not opts.not_global_sync)
