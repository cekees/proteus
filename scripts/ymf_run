#!/usr/bin/env python
"""Solve a YMF problem with Proteus, reproducibly, end to end.

    ymf_run examples/poisson.ymf                       # every discretization
    ymf_run spec.ymf --discretization taylor_hood --cells 4 8 16
    ymf_run out/poisson_P1_linear_8.ymf                # rerun an archive
    ymf_run out/poisson_P1_linear_8.ymf --check        # ...and compare

The input is either a problem specification (monolithic, or composed with
``extends``) or an archive this tool wrote. For a specification it runs each
discretization (or the one named) on each mesh of the sequence and prints
the L2 error of every unknown against the exact solution, with observed
rates. Each run writes an archive, <stem>_<discretization>_<cells>.ymf plus
its .h5 and .xmf, whose ``extra`` records everything needed to reproduce
it: the composed specification (self-contained), the run configuration,
the generated ADR form, software versions and the errors.

Given such an archive instead, it reruns exactly that run from the record
alone. With ``--check`` it then verifies the pipeline is idempotent: the
regenerated ADR form must equal the recorded one and every numerical
dataset must be bitwise identical to the original's.

This is the front end, so it imports sympy through ymf.symbolic. Proteus
itself (proteus.ADRProblem) never does: it is handed plain data.
"""
import argparse
import datetime
import math
import os
import platform
import subprocess
import sys

#: archive format of the run record in ``extra``
RECORD_VERSION = 1


def element_spaces(problem, finite_element):
    """Map the spec's finite_element block onto scalar components.

    ``fields`` applies to every unknown; in a velocity-pressure system,
    ``velocity`` applies to the vector unknown and ``pressure`` to the
    scalar one.
    """
    unknowns = problem["unknowns"]
    spaces = {}
    if "fields" in finite_element:
        fe = finite_element["fields"]
        for comps in unknowns.values():
            for c in comps:
                spaces[c] = [fe["family"], int(fe["order"])]
    for key, vector in (("velocity", True), ("pressure", False)):
        if key in finite_element:
            fe = finite_element[key]
            for name, comps in unknowns.items():
                if (len(comps) > 1) == vector:
                    for c in comps:
                        spaces[c] = [fe["family"], int(fe["order"])]
    missing = [c for comps in unknowns.values() for c in comps if c not in spaces]
    if missing:
        raise SystemExit("finite_element gives no space for %s" % ", ".join(missing))
    return spaces


def time_stepping(discretization, problem):
    block = discretization.get("discretization") or {}
    if "time_integration" not in block:
        return None
    if block["time_integration"] != "backward_euler":
        raise SystemExit("time integration %r is not wired up yet (backward_euler is)"
                         % block["time_integration"])
    if not problem.get("time"):
        raise SystemExit("%s steps in time, but the problem's domain gives no time "
                         "interval (', t ∈ (t0, t1]')" % discretization["name"])
    return {"dt": float(block["dt"]), "outputs": int(block.get("outputs", 1))}


def software():
    """Versions of everything the result depends on."""
    import numpy
    import sympy
    import ymf
    import proteus
    def commit(module):
        here = os.path.dirname(os.path.abspath(module.__file__))
        try:
            return subprocess.run(["git", "-C", here, "describe", "--always", "--dirty"],
                                  capture_output=True, text=True, check=True).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            return None      # an installed package, not a checkout
    return {"ymf": ymf.__version__, "ymf_git": commit(ymf),
            "proteus": proteus.__version__, "proteus_git": commit(proteus),
            "sympy": sympy.__version__, "numpy": numpy.__version__,
            "python": platform.python_version(), "platform": platform.platform()}


def plain(value):
    """The composed spec as plain YAML-safe data (strictyaml gives dicts already)."""
    if isinstance(value, dict):
        return {str(k): plain(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [plain(v) for v in value]
    return value


def solve(doc, problem, discretization, cells, outdir, name, levels=1, inline=False):
    """Run one discretization on one mesh; return (errors, archive path).

    ``cells`` sizes the coarsest mesh; ``levels`` > 1 refines it uniformly
    that many times less one (Proteus's nLevels), and the solution and
    errors are on the finest. ``inline`` writes the arrays into the .ymf
    itself instead of an .h5 beside it.
    """
    from proteus import ADRProblem, Profiling
    Profiling.logLevel = 1
    Profiling.verbose = False
    spaces = element_spaces(problem, discretization.get("finite_element") or {})
    time = time_stepping(discretization, problem)
    weak = {w["label"]: w for w in doc["Problem"].get("weak_forms", [])}.get(
        str(discretization.get("from_weak_form")), {})
    stabilization = (weak.get("stabilization_method") or "none").strip().lower()
    run = {"discretization": discretization["name"], "cells": cells, "levels": levels,
           "spaces": spaces, "time": time, "stabilization": stabilization,
           "storage": "inline" if inline else "hdf5"}
    extra = {"ymf_run": RECORD_VERSION, "spec": plain(doc), "run": run,
             "adr": problem, "provenance": dict(software(), created=datetime.datetime.now(
                 datetime.timezone.utc).isoformat(timespec="seconds"))}
    from proteus.iproteus import opts
    opts.dataDir = outdir
    cwd = os.getcwd()
    os.chdir(outdir)
    try:
        _, _, errors = ADRProblem.run(problem, {c: tuple(s) for c, s in spaces.items()},
                                      cells, time, name=name, stabilization=stabilization,
                                      extra=extra, levels=levels)
    finally:
        os.chdir(cwd)
    # the errors are known only after the solve; add them to the record
    path = os.path.join(outdir, name + ".ymf")
    from ymf.archive import inline_domain, read_ymf, write_ymf
    domain, extra = read_ymf(path)
    extra["results"] = {"l2_errors": errors}
    if inline:
        # copy the arrays in, then drop the .h5 this run wrote and derive the
        # .xmf again from the self-contained archive
        from ymf.xdmf import write_xdmf
        domain = inline_domain(domain, outdir)
        os.remove(os.path.join(outdir, name + ".h5"))
        write_xdmf(domain, os.path.join(outdir, name + ".xmf"), ymf_extra=extra)
    write_ymf(domain, path, extra=extra)
    return errors, path


def run_spec(path, args):
    from ymf import load_ymf
    from ymf.symbolic import adr_problem
    doc = load_ymf(path)
    problem = adr_problem(doc)
    discretizations = doc["solution_paths"]["discretizations"]
    if args.discretization:
        discretizations = [d for d in discretizations if d["name"] == args.discretization]
        if not discretizations:
            raise SystemExit("no discretization named %r" % args.discretization)
    weak_forms = {w["label"]: w for w in doc["Problem"].get("weak_forms", [])}
    from proteus.ADRProblem import STABILIZATIONS
    stem = os.path.splitext(os.path.basename(path))[0]
    print("%s: %s" % (path, doc["Problem"]["name"]))
    print("unknowns: %s" % ", ".join("%s (%s)" % (n, ", ".join(c)) for n, c in problem["unknowns"].items()))
    for d in discretizations:
        weak = weak_forms.get(str(d.get("from_weak_form")), {})
        method = (weak.get("stabilization_method") or "none").strip()
        if method.lower() not in STABILIZATIONS:
            # Running it without would solve a different weak form under
            # this branch's name.
            print("\n%s -- skipped: its weak form %r needs %s stabilization, which "
                  "is not wired up yet" % (d["name"], weak.get("label"), method))
            continue
        spaces = element_spaces(problem, d.get("finite_element") or {})
        time = time_stepping(d, problem)
        print("\n%s -- %s%s%s" % (
            d["name"], ", ".join("%s %s%d" % (c, f, o) for c, (f, o) in spaces.items()),
            "" if method.lower() == "none" else ", " + method,
            "" if time is None else ", backward Euler dt=%g on (%g, %g]" % (
                time["dt"], problem["time"][0], problem["time"][1])))
        names = list(problem["exact"])
        print("  cells  " + "".join("  L2(%s)    rate  " % n for n in names)
              + ("" if args.levels == 1 else "   (finest of %d levels)" % args.levels))
        previous = None
        for cells in args.cells:
            errors, _ = solve(doc, problem, d, cells, args.outdir,
                              "%s_%s_%d%s" % (stem, d["name"], cells,
                                              "" if args.levels == 1 else "x%d" % args.levels),
                              levels=args.levels, inline=args.inline)
            row = "  %5d  " % (cells * 2 ** (args.levels - 1))
            for n in names:
                rate = ""
                if previous and previous[n] > 0 and errors[n] > 0:
                    rate = "%5.2f" % math.log2(previous[n] / errors[n])
                row += "  %.3e %5s  " % (errors[n], rate)
            print(row, flush=True)
            previous = errors


def run_archive(path, args):
    """Rerun the run an archive records; with --check, compare the two."""
    import yaml
    from ymf import validate_ymf
    from ymf.archive import read_ymf
    from ymf.symbolic import adr_problem
    _, extra = read_ymf(path)
    if not extra or "run" not in extra or "spec" not in extra:
        raise SystemExit("%s does not record a ymf_run run (no spec and run in extra)" % path)
    # Validate the embedded spec exactly as a spec file would be.
    doc = validate_ymf(yaml.safe_dump(extra["spec"], allow_unicode=True, sort_keys=False))
    problem = adr_problem(doc)
    run = extra["run"]
    discretization = next(d for d in doc["solution_paths"]["discretizations"]
                          if d["name"] == run["discretization"])
    stem = os.path.splitext(os.path.basename(path))[0]
    name = stem + "_rerun"
    errors, rerun_path = solve(doc, problem, discretization, int(run["cells"]),
                               args.outdir, name, levels=int(run.get("levels", 1)),
                               inline=run.get("storage") == "inline")
    print("%s: reran %s on %d cells -> %s" % (path, run["discretization"], run["cells"], rerun_path))
    print("  errors: %s" % ", ".join("%s %.6e" % kv for kv in errors.items()))
    if not args.check:
        return 0
    failures = []
    if problem != extra["adr"]:
        failures.append("the regenerated ADR form differs from the recorded one")
    recorded = extra.get("results", {}).get("l2_errors", {})
    if recorded != errors:
        failures.append("errors differ: recorded %s, rerun %s" % (recorded, errors))
    failures += compare_arrays(path, rerun_path)
    if failures:
        print("NOT IDEMPOTENT:\n  " + "\n  ".join(failures))
        return 1
    print("  idempotent: same ADR form, same errors, every numerical dataset bitwise identical")
    return 0


def compare_arrays(a, b):
    """Every array of two archives, compared exactly, however each is stored."""
    import numpy
    from ymf.archive import domain_arrays, read_ymf
    arrays = []
    for path in (a, b):
        domain, _ = read_ymf(path)
        arrays.append(domain_arrays(domain, os.path.dirname(os.path.abspath(path))))
    failures = []
    if set(arrays[0]) != set(arrays[1]):
        failures.append("the archives hold different fields: %s"
                        % sorted(set(arrays[0]) ^ set(arrays[1])))
    for where in sorted(set(arrays[0]) & set(arrays[1])):
        x, y = arrays[0][where], arrays[1][where]
        if x.dtype != y.dtype or x.shape != y.shape or not numpy.array_equal(x, y):
            failures.append("%s: differs" % where)
    print("  compared %d arrays" % len(arrays[0]))
    return failures


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("input", help="a spec .ymf, or an archive .ymf this tool wrote")
    parser.add_argument("--discretization", help="run only this one (by name)")
    parser.add_argument("--cells", type=int, nargs="+", default=[4, 8, 16],
                        help="cells per side of each mesh in the sequence")
    parser.add_argument("--levels", type=int, default=1,
                        help="mesh levels: refine each mesh uniformly levels-1 times "
                             "and solve on the finest (Proteus nLevels)")
    parser.add_argument("--inline", action="store_true",
                        help="write the arrays into the .ymf itself: one self-contained "
                             "file (plus its .xmf), no .h5")
    parser.add_argument("--outdir", default=".", help="where archives are written")
    parser.add_argument("--check", action="store_true",
                        help="for an archive: verify the rerun reproduces it exactly")
    args = parser.parse_args(argv)
    args.outdir = os.path.abspath(args.outdir)
    os.makedirs(args.outdir, exist_ok=True)

    from ymf.archive import YmfArchiveError, read_ymf
    try:
        read_ymf(args.input)
        is_archive = True
    except YmfArchiveError:
        is_archive = False
    if is_archive:
        return run_archive(args.input, args)
    run_spec(args.input, args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
